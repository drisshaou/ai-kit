{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash({{CMD_TEST}} *)",
      "Bash({{CMD_LINT}} *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.development)",
      "Read(/**/.env.production)",
      "Read(/**/.env.test)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Edit(/**/.env.development)",
      "Edit(/**/.env.production)",
      "Edit(/**/.env.test)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "c=\"$HOME/.claude/skills/learn-skill/scripts/check-skill.sh\"; \"$c\" check \"$CLAUDE_PROJECT_DIR/.claude/skills\" --changed --agents \"$CLAUDE_PROJECT_DIR/.agents/skills\" 2>/dev/null; \"$c\" budget \"$CLAUDE_PROJECT_DIR/CLAUDE.md\" 150 2>/dev/null; true"
          }
        ]
      }
    ]
  }
}
